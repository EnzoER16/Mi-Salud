+++ b/backend/routes/vaccine_routes.py
@@ -0,0 +1,122 @@
+from flask import Blueprint, request, jsonify, g
+from flask_jwt_extended import jwt_required, get_jwt_identity
+from functools import wraps
+
+from config.settings import db
+from models.patient import Patient
+from models.patient_vaccine import PatientVaccine
+from routes.auth_routes import role_required
+import validators as v
+
+vaccine_bp = Blueprint("vaccine", __name__, url_prefix="/api/vaccines")
+
+MAX_VACCINES = 150
+
+VACCINE_SPEC = {
+    "name": v.text("El nombre de la vacuna", 100, required=True),
+    "dose": v.text("La dosis", 40),
+    "applied_on": v.day("La fecha de aplicación"),
+    "next_dose_on": v.day("La fecha de la próxima dosis", allow_future=True),
+    "place": v.text("El lugar", 100),
+    "notes": v.text("Las notas", 255),
+}
+
+
+def patient_required(fn):
+    @wraps(fn)
+    def wrapper(*args, **kwargs):
+        patient = Patient.query.filter_by(id_user=get_jwt_identity()).first()
+        if not patient:
+            return jsonify({"message": "Perfil de paciente no encontrado. Completá tus datos primero."}), 404
+        g.patient = patient
+        return fn(*args, **kwargs)
+    return wrapper
+
+
+def vaccines_payload(patient_id):
+    """Carnet ordenado: lo más reciente primero y las que no tienen fecha al final."""
+    vaccines = PatientVaccine.query.filter_by(id_patient=patient_id).all()
+    vaccines.sort(key=lambda x: (x.applied_on is None, -(x.applied_on.toordinal()) if x.applied_on else 0, x.name.lower()))
+    return [x.to_json() for x in vaccines]
+
+
+def _check_dates(applied_on, next_dose_on):
+    if applied_on and next_dose_on and next_dose_on <= applied_on:
+        return "La próxima dosis tiene que ser posterior a la fecha de aplicación."
+    return None
+
+
+@vaccine_bp.route("/", methods=["GET"])
+@jwt_required()
+@role_required("Paciente")
+@patient_required
+def list_vaccines():
+    return jsonify(vaccines_payload(g.patient.id_patient)), 200
+
+
+@vaccine_bp.route("/", methods=["POST"])
+@jwt_required()
+@role_required("Paciente")
+@patient_required
+def add_vaccine():
+    data = request.get_json(silent=True) or {}
+    try:
+        cleaned = v.parse_fields({k: data.get(k) for k in VACCINE_SPEC}, VACCINE_SPEC)
+    except v.ValidationError as err:
+        return jsonify({"message": str(err)}), 400
+
+    problem = _check_dates(cleaned["applied_on"], cleaned["next_dose_on"])
+    if problem:
+        return jsonify({"message": problem}), 400
+
+    if PatientVaccine.query.filter_by(id_patient=g.patient.id_patient).count() >= MAX_VACCINES:
+        return jsonify({"message": f"Alcanzaste el máximo de {MAX_VACCINES} vacunas cargadas."}), 400
+
+    vaccine = PatientVaccine(id_patient=g.patient.id_patient, **cleaned)
+    db.session.add(vaccine)
+    db.session.commit()
+    return jsonify(vaccine.to_json()), 201
+
+
+def _owned_vaccine(vaccine_id):
+    return PatientVaccine.query.filter_by(id_vaccine=vaccine_id, id_patient=g.patient.id_patient).first()
+
+
+@vaccine_bp.route("/<vaccine_id>", methods=["PATCH"])
+@jwt_required()
+@role_required("Paciente")
+@patient_required
+def update_vaccine(vaccine_id):
+    vaccine = _owned_vaccine(vaccine_id)
+    if not vaccine:
+        return jsonify({"message": "Vacuna no encontrada."}), 404
+
+    data = request.get_json(silent=True) or {}
+    try:
+        cleaned = v.parse_fields(data, VACCINE_SPEC)
+    except v.ValidationError as err:
+        return jsonify({"message": str(err)}), 400
+
+    applied_on = cleaned.get("applied_on", vaccine.applied_on)
+    next_dose_on = cleaned.get("next_dose_on", vaccine.next_dose_on)
+    problem = _check_dates(applied_on, next_dose_on)
+    if problem:
+        return jsonify({"message": problem}), 400
+
+    for key, value in cleaned.items():
+        setattr(vaccine, key, value)
+    db.session.commit()
+    return jsonify(vaccine.to_json()), 200
+
+
+@vaccine_bp.route("/<vaccine_id>", methods=["DELETE"])
+@jwt_required()
+@role_required("Paciente")
+@patient_required
+def delete_vaccine(vaccine_id):
+    vaccine = _owned_vaccine(vaccine_id)
+    if not vaccine:
+        return jsonify({"message": "Vacuna no encontrada."}), 404
+    db.session.delete(vaccine)
+    db.session.commit()
+    return jsonify({"message": "Vacuna eliminada."}), 200
diff --git a/backend/validators.py b/backend/validators.py
new file mode 100644
index 0000000..febca0b
--- /dev/null
+++ b/backend/validators.py
@@ -0,0 +1,147 @@
+"""Validadores chicos y reutilizables para los datos de perfil, ficha médica y vacunas.
+
+Cada función recibe el valor crudo del JSON y devuelve el valor limpio (o None si quedó vacío).
+Si el dato no es válido lanzan ValidationError con un mensaje listo para mostrarle al usuario.
+"""
+import re
+from datetime import date, datetime
+
+
+class ValidationError(Exception):
+    pass
+
+
+def _empty(value):
+    return value is None or (isinstance(value, str) and not value.strip())
+
+
+def text(label, max_len, required=False):
+    def check(value):
+        if _empty(value):
+            if required:
+                raise ValidationError(f"{label} es obligatorio.")
+            return None
+        if not isinstance(value, str):
+            raise ValidationError(f"{label} no es válido.")
+        value = " ".join(value.split()) if "\n" not in value else value.strip()
+        if len(value) > max_len:
+            raise ValidationError(f"{label} no puede superar los {max_len} caracteres.")
+        return value
+    return check
+
+
+def phone(label, required=False):
+    def check(value):
+        value = text(label, 25, required)(value)
+        if value is None:
+            return None
+        digits = re.sub(r"\D", "", value)
+        if not re.fullmatch(r"[0-9+\-()\s]+", value) or not (6 <= len(digits) <= 15):
+            raise ValidationError(f"{label} no es un teléfono válido.")
+        return value
+    return check
+
+
+def postal_code(label):
+    def check(value):
+        value = text(label, 10)(value)
+        if value is not None and not re.fullmatch(r"[A-Za-z0-9 ]{3,10}", value):
+            raise ValidationError(f"{label} no es válido.")
+        return value
+    return check
+
+
+def choice(label, options, required=False):
+    def check(value):
+        if _empty(value):
+            if required:
+                raise ValidationError(f"{label} es obligatorio.")
+            return None
+        if value not in options:
+            raise ValidationError(f"{label} no es una opción válida.")
+        return value
+    return check
+
+
+def day(label, allow_future=False, min_year=1900, required=False):
+    """Fecha en formato AAAA-MM-DD."""
+    def check(value):
+        if _empty(value):
+            if required:
+                raise ValidationError(f"{label} es obligatoria.")
+            return None
+        try:
+            parsed = datetime.strptime(str(value)[:10], "%Y-%m-%d").date()
+        except ValueError:
+            raise ValidationError(f"{label} no es una fecha válida.")
+        if parsed.year < min_year:
+            raise ValidationError(f"{label} no es una fecha válida.")
+        if not allow_future and parsed > date.today():
+            raise ValidationError(f"{label} no puede ser una fecha futura.")
+        return parsed
+    return check
+
+
+def number(label, minimum, maximum, integer=False):
+    def check(value):
+        if _empty(value):
+            return None
+        try:
+            parsed = float(str(value).replace(",", "."))
+        except ValueError:
+            raise ValidationError(f"{label} debe ser un número.")
+        if not (minimum <= parsed <= maximum):
+            raise ValidationError(f"{label} debe estar entre {minimum} y {maximum}.")
+        return int(round(parsed)) if integer else round(parsed, 1)
+    return check
+
+
+def boolean(label):
+    def check(value):
+        if value is None or value == "":
+            return None
+        if isinstance(value, bool):
+            return value
+        raise ValidationError(f"{label} no es válido.")
+    return check
+
+
+def string_list(label, max_items=20, max_len=60):
+    def check(value):
+        if value is None:
+            return []
+        if not isinstance(value, list):
+            raise ValidationError(f"{label} no es válido.")
+        clean = []
+        for item in value:
+            if not isinstance(item, str) or not item.strip():
+                continue
+            item = " ".join(item.split())
+            if len(item) > max_len:
+                raise ValidationError(f"Un elemento de {label} supera los {max_len} caracteres.")
+            if item not in clean:
+                clean.append(item)
+        if len(clean) > max_items:
+            raise ValidationError(f"{label} admite hasta {max_items} elementos.")
+        return clean
+    return check
+
+
+def parse_fields(data, spec):
+    """Limpia SOLO las claves que vinieron en `data` (así un PUT parcial no borra lo demás)."""
+    cleaned = {}
+    for key, check in spec.items():
+        if key in data:
+            cleaned[key] = check(data[key])
+    return cleaned
+
+
+def age_from(birth_date):
+    if not birth_date:
+        return None
+    today = date.today()
+    return today.year - birth_date.year - ((today.month, today.day) < (birth_date.month, birth_date.day))
+
+
+def iso(value):
+    return value.isoformat() if value else None
